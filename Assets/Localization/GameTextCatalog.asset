  - key: dream.chain.description
    ko: "\uc120\uc0dd\ub2d8\uc744 \ub9cc\ub098 \ud558\ub8e8 \uacc4\ud68d\uc744 \uc138\uc6b0\uace0, \ub9c8\uc744\uc758 \ub124 \uc2dc\uc124\uc744 \ub458\ub7ec\ubcf4\uc790. \ucc98\uc74c \ubc88 \uc6a9\ub3c8\uacfc \ub0b4 \uafc8\uc744 \ub0b4 \ubc29\uc5d0 \ub0a8\uaca8 \ubcf4\uc790."
    en: "Meet your teacher, plan your day and explore four town facilities. Keep your first allowance and your dream in your room."
  - key: dream.campaign.description
    ko: "\uc120\uc0dd\ub2d8\uacfc \ud558\ub8e8 \uacc4\ud68d, \ub9c8\uc744 \uc77c\uac70\ub9ac, \ub0b4 \uafc8\uc744 \ucc28\ub840\ub85c \ub9cc\ub098 \ubcf4\uc790. \uac01 \ub0a0\uc758 \uc131\uc7a5\uc5d0\ub294 \ud559\uad50 \ubc16 \ub300\uc548\ub3c4 \uc788\ub2e4."
    en: "Meet your teacher, try town jobs and think about your dream. Each day offers an alternative way to grow outside class."
  - key: dream.quest.my-dream.name
    ko: "\ub0b4\uac00 \ub418\uace0 \uc2f6\uc740 \uac83"
    en: "My Dream"
  - key: dream.quest.my-dream.description
    ko: "\ucee4\uc11c \ubb50\uac00 \ub418\uace0 \uc2f6\uc740\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc790. \uc7a5\ub798\ud76c\ub9dd\uc744 \uace8\ub77c\ub3c4 \uc88b\uace0, \ub3c4\uc11c\uad00\uc5d0\uc11c \uc9c1\uc5c5 \ucc45\uc744 \uc77d\uac70\ub098 \uacf5\ubc29\uc5d0\uc11c \uc77c\ud558\ub294 \ubaa8\uc2b5\uc744 \ubd10\ub3c4 \uc88b\uc544. \uafc8\uc740 \uc5b8\uc81c\ub4e0 \ubc14\uafc0 \uc218 \uc788\uc5b4."
    en: "Think about what you want to be. Choose a dream, read about jobs at the library or watch people work at the workshop. You can always change your mind."
  - key: dream.quest.first-job.description
    ko: "\ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uacf3\uc744 \uace8\ub77c \uc77c\uc744 \ub3d5\uace0 \uc6a9\ub3c8\uc744 \ubc1b\uc544 \ubcf4\uc790. \uc77c\ud574 \ubcf8 \uacf3\uc740 \ub0b4 \uafc8\uc744 \ucc3e\ub294 \ub370\ub3c4 \ub3c4\uc6c0\uc774 \ub41c\ub2e4."
    en: "Pick a place you like, help out and earn allowance. Trying real work also helps you find your dream."
  - key: dream.day.2.direction
    ko: "\ub124 \uc9c4\ub85c \uc2dc\uc124\uc744 \ubc29\ubb38\ud558\uace0, \ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uacf3\uc5d0\uc11c \uc77c\uc744 \ub3c4\uc640 \uc6a9\ub3c8\uc744 \ubc8c\uc790."
    en: "Visit the four career facilities, then earn allowance by helping at a place you like."
  - key: dream.day.2.next
    ko: "\ub0b4\uc77c\uc740 \ucee4\uc11c \ubb50\uac00 \ub418\uace0 \uc2f6\uc740\uc9c0 \uc0dd\uac01\ud574 \ubcf4\uc790."
    en: "Tomorrow, think about what you want to be when you grow up."
  - key: dream.day.3.name
    ko: "\uc14b\uc9f8 \ub0a0: \ub0b4\uac00 \ub418\uace0 \uc2f6\uc740 \uac83"
    en: "Day 3: My Dream"
  - key: dream.day.3.direction
    ko: "\uc120\uc0dd\ub2d8\uc774 \ucee4\uc11c \ubb50\uac00 \ub418\uace0 \uc2f6\uc740\uc9c0 \ubb3c\uc5b4\ubd24\uc5b4. \uc9c1\uc5c5 \ucc45\uc744 \uc77d\uac70\ub098 \uc77c\ud558\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uba74\uc11c \uc0dd\uac01\ud574 \ubcf4\uc790."
    en: "Your teacher asked what you want to be. Read books about jobs or watch people work while you think about it."
  - key: dream.activity.job-books.action
    ko: "\ub3c4\uc11c\uad00\uc5d0\uc11c \uc9c1\uc5c5 \ucc45 \uc77d\uae30"
    en: "Read books about jobs at the library"
  - key: dream.activity.job-books.result
    ko: "\uc694\ub9ac\uc0ac, \uc751\uae09 \uc758\ub8cc, \uc778\ud14c\ub9ac\uc5b4 \ub514\uc790\uc774\ub108, \uad70\uc778\uc774 \ub098\uc624\ub294 \ucc45\uc744 \uc77d\uc5c8\uc5b4\uc694. \uc5b4\ub5a4 \uc77c\uc744 \ud558\ub294\uc9c0 \uc870\uae08 \uc54c \uac83 \uac19\uc544\uc694. \ub098\ub294 \ucee4\uc11c \ubb50\uac00 \ub420\uae4c\uc694?"
    en: "You read about chefs, emergency care, interior designers and soldiers. Now you know a little about their work. What will you be when you grow up?"
  - key: dream.activity.watch-work.action
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc77c\ud558\ub294 \ubaa8\uc2b5 \ubcf4\uae30"
    en: "Watch people work at the workshop"
  - key: dream.activity.watch-work.result
    ko: "\uc5b4\ub978\ub4e4\uc774 \uac00\uad6c\ub97c \uace0\uce58\uace0 \ub3c4\uad6c\ub97c \uc815\ub9ac\ud558\ub294 \ubaa8\uc2b5\uc744 \ubd24\uc5b4\uc694. \uac00\uae4c\uc774\uc5d0\uc11c \ubcf4\ub2c8 \ub098\ub3c4 \ud574 \ubcf4\uace0 \uc2f6\uc5b4\uc84c\uc5b4\uc694."
    en: "You watched people fix furniture and put away their tools. Seeing it up close makes you want to try it too."
  - key: dream.objective.job-books
    ko: "\ub3c4\uc11c\uad00\uc5d0\uc11c \uc9c1\uc5c5 \ucc45 \uc77d\uae30"
    en: "Read books about jobs at the library"
  - key: dream.objective.watch-work
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc77c\ud558\ub294 \ubaa8\uc2b5 \ubcf4\uae30"
    en: "Watch people work at the workshop"
  - key: dream.objective.choice
    ko: "\uc7a5\ub798\ud76c\ub9dd\uc744 \uace0\ub974\uac70\ub098, \uc9c1\uc5c5 \ucc45\uc744 \uc77d\uac70\ub098, \uc77c\ud558\ub294 \ubaa8\uc2b5 \ubcf4\uae30"
    en: "Choose a dream, read about jobs or watch people work"
  - key: dream.objective.work
    ko: "\ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uacf3\uc5d0\uc11c \uc720\uae09 \uc77c\uac70\ub9ac \uc644\ub8cc\ud558\uae30"
    en: "Complete paid work at a place you like"
  - key: dream.route.job-books
    ko: "\uc9c1\uc5c5 \ucc45 \uc77d\uae30"
    en: "Read about jobs"
  - key: dream.route.job-books.description
    ko: "\ub3c4\uc11c\uad00\uc5d0\uc11c \uad81\uae08\ud55c \uc9c1\uc5c5\uc758 \ucc45\uc744 \uc77d\ub294\ub2e4."
    en: "Read about a job you are curious about at the library."
  - key: dream.route.watch-work
    ko: "\uc77c\ud558\ub294 \ubaa8\uc2b5 \ubcf4\uae30"
    en: "Watch people work"
  - key: dream.route.watch-work.description
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc5b4\ub978\ub4e4\uc774 \uc77c\ud558\ub294 \ubaa8\uc2b5\uc744 \ubcf8\ub2e4."
    en: "Watch people work at the workshop."
  - key: dream.route.restaurant-work
    ko: "\uc2dd\ub2f9 \uc77c \ub3d5\uae30"
    en: "Help at the restaurant"
  - key: dream.route.restaurant-work.description
    ko: "\uc2dd\ub2f9\uc758 \uc720\uae09 \uc77c\uac70\ub9ac\ub97c \uc644\ub8cc\ud55c\ub2e4."
    en: "Complete paid work at the restaurant."
  - key: dream.route.clinic-work
    ko: "\uc9c4\ub8cc\uc18c \uc77c \ub3d5\uae30"
    en: "Help at the clinic"
  - key: dream.route.clinic-work.description
    ko: "\ubcf4\uac74 \uc9c4\ub8cc\uc18c\uc758 \uc720\uae09 \uc77c\uac70\ub9ac\ub97c \uc644\ub8cc\ud55c\ub2e4."
    en: "Complete paid work at the medical clinic."
  - key: dream.route.studio-work
    ko: "\uc2a4\ud29c\ub514\uc624 \uc77c \ub3d5\uae30"
    en: "Help at the studio"
  - key: dream.route.studio-work.description
    ko: "\ub514\uc790\uc778 \uc2a4\ud29c\ub514\uc624\uc758 \uc720\uae09 \uc77c\uac70\ub9ac\ub97c \uc644\ub8cc\ud55c\ub2e4."
    en: "Complete paid work at the design studio."
  - key: dream.route.training-work
    ko: "\ud6c8\ub828\uc7a5 \uc815\ub9ac \ub3d5\uae30"
    en: "Help at the training ground"
  - key: dream.route.training-work.description
    ko: "\ud6c8\ub828\uc7a5\uc758 \uc720\uae09 \uc77c\uac70\ub9ac\ub97c \uc644\ub8cc\ud55c\ub2e4."
    en: "Complete paid work at the training ground."
  - key: dream.work.restaurant-helper
    ko: "\uc2dd\ub2f9 \uc77c \ub3d5\uae30"
    en: "Help at the restaurant"
  - key: dream.work.clinic-helper
    ko: "\uc9c4\ub8cc\uc18c \uc77c \ub3d5\uae30"
    en: "Help at the clinic"
  - key: dream.work.studio-helper
    ko: "\uc2a4\ud29c\ub514\uc624 \uc77c \ub3d5\uae30"
    en: "Help at the studio"
  - key: dream.work.training-helper
    ko: "\ud6c8\ub828\uc7a5 \uc815\ub9ac \ub3d5\uae30"
    en: "Help tidy the training ground"
  - key: dream.dialogue.teacher
    ko: "\ud558\ub8e8\ub97c \ubcf4\ub0b4\ub294 \ubc29\ubc95\uc740 \uc5ec\ub7ec \uac00\uc9c0\ub780\ub2e4. \uc624\ub298\uc758 \uacc4\ud68d\uc5d0\uc11c \ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uc77c\uc744 \uace8\ub77c \ubcf4\ub834. \uadf8\ub9ac\uace0 \uc0dd\uac01\ud574 \ubcf4\ub834, \ucee4\uc11c \ubb50\uac00 \ub418\uace0 \uc2f6\ub2c8? \ub098\uc911\uc5d0 \ubc14\uafd4\ub3c4 \uad1c\ucc2e\uc544."
    en: "There are many ways to spend a day. Choose something in your Daily Plan. And think about it: what do you want to be when you grow up? It's fine to change your mind."
  - key: dream.dialogue.librarian
    ko: "\uad81\uae08\ud55c \uc9c1\uc5c5\uc774 \uc788\ub2c8? \uc77c\uc744 \uc18c\uac1c\ud558\ub294 \ucc45\uc740 \uc800\ucabd \ucc45\uc7a5\uc5d0 \uc788\uc5b4. \ucc9c\ucc9c\ud788 \uc77d\uc5b4 \ubcf4\ub834."
    en: "Is there a job you're curious about? Books about jobs are on that shelf. Take your time."
  - key: dream.dialogue.manager
    ko: "\uacf5\ubc29 \uc77c\uc744 \ub3c4\uc640\uc904\ub798? \uc77c\uc774 \ub05d\ub098\uba74 \uc5b4\ub978\ub4e4\uc774 \uc77c\ud558\ub294 \ubaa8\uc2b5\ub3c4 \uad6c\uacbd\ud574 \ubcf4\ub834. \ud574 \ubcf4\uace0 \uc2f6\uc740 \uc77c\uc774 \uc0dd\uae38\uc9c0\ub3c4 \ubab0\ub77c."
    en: "Would you help around the workshop? Afterwards, watch how everyone works. You might find something you want to try."
  - key: dream.interest.chef.description
    ko: "\ub9db\uc788\ub294 \uc74c\uc2dd\uc73c\ub85c \uc0ac\ub78c\ub4e4\uc744 \ub3cc\ubcf4\ub294 \uc694\ub9ac\uc0ac\uac00 \ub418\uace0 \uc2f6\uc5b4\uc694."
    en: "I want to be a chef who cares for people with good food."
  - key: dream.interest.chef.action
    ko: "\uc2dd\ub2f9 \uc77c\uc744 \ub3c4\uc640 \ubcf4\uc790."
    en: "Try helping at the restaurant."
  - key: dream.interest.emergency-care.description
    ko: "\uc544\ud508 \uc0ac\ub78c\uacfc \ub3d9\ubb3c\uc744 \uce68\ucc29\ud558\uac8c \ub3d5\ub294 \uc0ac\ub78c\uc774 \ub418\uace0 \uc2f6\uc5b4\uc694."
    en: "I want to calmly help people and animals who are hurt."
  - key: dream.interest.emergency-care.action
    ko: "\uc9c4\ub8cc\uc18c \uc77c\uc744 \ub3c4\uc640 \ubcf4\uc790."
    en: "Try helping at the clinic."
  - key: dream.interest.interior.description
    ko: "\uc0ac\ub78c\uc5d0\uac8c \uaf2d \ub9de\ub294 \uacf5\uac04\uc744 \uafb8\ubbf8\ub294 \ub514\uc790\uc774\ub108\uac00 \ub418\uace0 \uc2f6\uc5b4\uc694."
    en: "I want to be a designer who makes rooms that suit people."
  - key: dream.interest.interior.action
    ko: "\uc2a4\ud29c\ub514\uc624 \uc77c\uc744 \ub3c4\uc640 \ubcf4\uc790."
    en: "Try helping at the studio."
  - key: dream.interest.soldier.description
    ko: "\ubab8\uacfc \ub9c8\uc74c\uc744 \ub2e8\ub828\ud574 \ubaa8\ub450\ub97c \uc9c0\ud0a4\ub294 \uad70\uc778\uc774 \ub418\uace0 \uc2f6\uc5b4\uc694."
    en: "I want to train my body and mind and protect everyone as a soldier."
  - key: dream.interest.soldier.action
    ko: "\ud6c8\ub828\uc7a5 \uc815\ub9ac\ub97c \ub3c4\uc640 \ubcf4\uc790."
    en: "Try helping at the training ground."
  - key: dream.location.library.description
    ko: "\uc870\uc6a9\ud788 \uacf5\ubd80\ud558\uac70\ub098 \uad81\uae08\ud55c \uc9c1\uc5c5 \ucc45\uc744 \uc77d\uc5b4\uc694."
    en: "Study quietly or read books about jobs you're curious about."
  - key: dream.location-state.library.afternoon.description
    ko: "\uc77d\uae30\ub97c \ub9c8\ucce4\uc5b4\uc694. \uc5f4\ub78c\ub300\uc5d0\uc11c \uad81\uae08\ud55c \uc9c1\uc5c5 \ucc45\uc744 \ub354 \ucc3e\uc544\ubcf4\uc138\uc694."
    en: "You finished reading. Look for more job books at the reference tables."
  - key: dream.location-state.record.hidden
    ko: "\uc544\uc9c1 \ub4e4\ub974\uc9c0 \uc54a\uc740 \uacf3\uc758 \uae30\ub85d"
    en: "A place you haven't visited yet"
  - key: dream.encyclopedia.job-shelf.name
    ko: "\uc9c1\uc5c5 \ucc45 \uc11c\uac00"
    en: "Job book shelf"
  - key: dream.encyclopedia.job-shelf.description
    ko: "\uc5ec\ub7ec \uc9c1\uc5c5\uc744 \uc18c\uac1c\ud558\ub294 \ucc45\uc744 \ubaa8\uc544 \ub454 \uacf3\uc785\ub2c8\ub2e4."
    en: "A shelf of books introducing many jobs."
  - key: dream.encyclopedia.job-shelf.hint
    ko: "\ub3c4\uc11c\uad00\uc744 \ub458\ub7ec\ubcf4\uba70 \uad81\uae08\ud55c \uc9c1\uc5c5\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    en: "Look around the library for a job you're curious about."
  - key: dream.encyclopedia.job-shelf.detail
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uaed8 \uc5ec\ucb64 \ubcf4\uba74 \uc5b4\uc6b8\ub9ac\ub294 \ucc45\uc744 \uace8\ub77c \uc8fc\uc138\uc694."
    en: "Ask the librarian to pick a book for you."
  - key: dream.encyclopedia.first-discovery.detail
    ko: "\ubc1c\uacac\ud55c \ub0b4\uc6a9\uc744 \uc774\uacf3\uc5d0\uc11c \ub2e4\uc2dc \uc77d\uc5b4\ubcfc \uc218 \uc788\uc5b4\uc694."
    en: "You can come back here to read what you found."
  - key: "dream.ui.locked-reason"
    ko: "\uc774 \uc2dc\uc124\uc758 \uc18c\uac1c\ub97c \ub4e4\uc73c\uba74 \uace0\ub97c \uc218 \uc788\uc5b4\uc694."
    en: "Listen to this facility's introduction to choose it."
  - key: "dream.journal.current"
    ko: "\uc9c0\uae08 \uafc8: {0}"
    en: "Current dream: {0}"
  - key: "dream.journal.none"
    ko: "\uc544\uc9c1 \uc815\ud558\uc9c0 \uc54a\uc558\uc5b4\uc694"
    en: "Not chosen yet"
  - key: "dream.journal.hint"
    ko: "\ub9c8\uc744\uc744 \ub458\ub7ec\ubcf4\uace0, \uc77c\ud574 \ubcf4\uace0, \ucc45\ub3c4 \uc77d\uc73c\uba74\uc11c \ucc9c\ucc9c\ud788 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694."
    en: "Explore the town, try some work and read books while you think about it."
  - key: "dialogue.librarian.intro"
    ko: "\ub3c4\uc11c\uad00\uc5d0 \uc628 \uac78 \ud658\uc601\ud574. \uc77d\uace0 \uc2f6\uc740 \ucc45\uc774 \uc788\uc73c\uba74 \ub9d0\ud574 \uc8fc\ub834."
    en: "Welcome to the library. Tell me if there's a book you'd like to read."
  - key: "dialogue.librarian.library"
    ko: "\uc624\ub298\uc740 \uc5b4\ub5a4 \ucc45\uc744 \uc77d\uc5b4 \ubcfc\uae4c? \uc9c1\uc5c5 \ucc45\ub3c4 \ub9ce\ub2e8\ub2e4."
    en: "What shall we read today? We have plenty of books about jobs."
  - key: "dialogue.librarian.square"
    ko: "\uc624\ub298\uc740 \ucc45\uc744 \ub4e4\uace0 \uad11\uc7a5\uc5d0 \ub098\uc654\uc5b4. \ubc14\uae65\uc5d0\uc11c \uc77d\ub294 \uac83\ub3c4 \uc88b\ub2e8\ub2e4."
    en: "I brought a book out to the square today. Reading outside is nice too."
  - key: "dialogue.workManager.intro"
    ko: "\uacf5\ubc29\uc5d0 \uc628 \uac78 \ud658\uc601\ud574. \uc190\uc744 \uc6c0\uc9c1\uc5ec \ubcf4\uba74 \uc88b\uc544\ud558\ub294 \uc77c\uc744 \uc54c\uac8c \ub420\uc9c0\ub3c4 \ubab0\ub77c."
    en: "Welcome to the workshop. Working with your hands may show you what you enjoy."
  - key: "dialogue.work-manager.workshop"
    ko: "\uc624\ub298\ub3c4 \uace0\uce60 \uac8c \ub9ce\uad6c\ub098. \ucc9c\ucc9c\ud788 \ub3c4\uc640\uc8fc\uba74 \ub3fc."
    en: "Lots to fix again today. Help out at your own pace."
  - key: "dialogue.work-manager.corner-store"
    ko: "\uc0c1\uc810 \uc120\ubc18\uc744 \uace0\uce58\ub7ec \uc654\uc5b4. \uc77c\uc740 \uc5b4\ub514\uc5d0\ub098 \uc788\ub2e8\ub2e4."
    en: "I came to fix the store's shelves. There's work everywhere."
  - key: "dialogue.teacher.intro"
    ko: "\ubc18\uac11\uad6c\ub098. \uc55e\uc73c\ub85c \ud568\uaed8 \uc990\uac81\uac8c \uc9c0\ub0b4\uc790."
    en: "Nice to meet you. Let's have a good time together."
  - key: "dialogue.teacher.school"
    ko: "\uc624\ub298\ub3c4 \ud559\uad50\uc5d0 \uc798 \uc654\uad6c\ub098. \uad81\uae08\ud55c \uac8c \uc788\uc73c\uba74 \ubb3c\uc5b4\ubcf4\ub834."
    en: "Good to see you at school. Ask me if you're curious about anything."
  - key: "dialogue.teacher.square"
    ko: "\ud559\uad50 \ubc16\uc5d0\uc11c \ub9cc\ub098\ub2c8 \ubc18\uac11\uad6c\ub098. \uc624\ub298\uc740 \ubb58 \ud558\uba70 \ubcf4\ub0b4\ub2c8?"
    en: "Nice to see you outside school. What are you up to today?"
  - key: "Library job books"
    ko: "\ub3c4\uc11c\uad00 \uc9c1\uc5c5 \ucc45"
    en: "Library job books"
  - key: "The library has a shelf of books about jobs."
    ko: "\ub3c4\uc11c\uad00\uc5d0 \uc9c1\uc5c5\uc744 \uc18c\uac1c\ud558\ub294 \ucc45\uc7a5\uc774 \uc788\uc5b4\uc694."
    en: "The library has a shelf of books about jobs."
  - key: "Books about many jobs are waiting at the library."
    ko: "\ub3c4\uc11c\uad00\uc5d0 \uc5ec\ub7ec \uc9c1\uc5c5\uc744 \uc18c\uac1c\ud558\ub294 \ucc45\uc774 \uc788\uc5b4\uc694."
    en: "Books about many jobs are waiting at the library."
  - key: "??? book"
    ko: "??? \ucc45"
    en: "??? book"
  - key: "A shelf of job books at the library"
    ko: "\ub3c4\uc11c\uad00\uc758 \uc9c1\uc5c5 \ucc45\uc7a5"
    en: "A shelf of job books at the library"
  - key: "Town board notice"
    ko: "\ub9c8\uc744 \uac8c\uc2dc\ud310 \uc548\ub0b4"
    en: "Town board notice"
  - key: "A notice recommends the library job books."
    ko: "\uac8c\uc2dc\ud310\uc5d0\uc11c \ub3c4\uc11c\uad00 \uc9c1\uc5c5 \ucc45\uc744 \ucd94\ucc9c\ud558\uace0 \uc788\uc5b4\uc694."
    en: "A notice recommends the library job books."
  - key: "Librarian tip"
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uc758 \ucd94\ucc9c"
    en: "Librarian tip"
  - key: "The librarian recommends a book about jobs."
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uc774 \uc9c1\uc5c5 \ucc45\uc744 \ucd94\ucc9c\ud574 \uc8fc\uc168\uc5b4\uc694."
    en: "The librarian recommends a book about jobs."
  - key: "Library Job Shelf"
    ko: "\ub3c4\uc11c\uad00 \uc9c1\uc5c5 \ucc45\uc7a5"
    en: "Library Job Shelf"
  - key: "Browse the shelf of books about jobs."
    ko: "\uc9c1\uc5c5 \ucc45\uc7a5\uc744 \ub458\ub7ec\ubd10\uc694."
    en: "Browse the shelf of books about jobs."
  - key: "Browse the job shelf"
    ko: "\uc9c1\uc5c5 \ucc45\uc7a5 \ub458\ub7ec\ubcf4\uae30"
    en: "Browse the job shelf"
  - key: "Look for a job you want to know about"
    ko: "\uad81\uae08\ud55c \uc9c1\uc5c5\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."
    en: "Look for a job you want to know about"
  - key: "See how repair work is noted at the workshop."
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc218\ub9ac \uae30\ub85d\uc744 \uc5b4\ub5bb\uac8c \ub0a8\uae30\ub294\uc9c0 \ubd10\uc694."
    en: "See how repair work is noted at the workshop."
  - key: "The workshop keeps repair notes you can look at."
    ko: "\uacf5\ubc29\uc5d0\ub294 \ubcfc \uc218 \uc788\ub294 \uc218\ub9ac \uae30\ub85d\uc774 \uc788\uc5b4\uc694."
    en: "The workshop keeps repair notes you can look at."
  - key: "Ask a librarian about books on jobs."
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uaed8 \uc9c1\uc5c5 \ucc45\uc744 \uc5ec\ucb64\ubd10\uc694."
    en: "Ask a librarian about books on jobs."
  - key: "The librarian suggests a book about jobs."
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uc774 \uc9c1\uc5c5 \ucc45\uc744 \uad8c\ud574 \uc8fc\uc168\uc5b4\uc694."
    en: "The librarian suggests a book about jobs."
  - key: dream.objective.room
    ko: "\ub0b4 \uafc8\uacfc \uc5b4\uc6b8\ub9ac\ub294 \uac00\uad6c\ub97c \ub0b4 \ubc29\uc5d0 \ub193\uc544 \ubcf4\uae30"
    en: "Place furniture that suits your dream in your room"
  - key: dream.quest.my-own-space.description
    ko: "\uaf2c\ub9c8 \uc694\ub9ac \uc138\ud2b8\ub098 \uc751\uae09 \ucc98\uce58 \ub180\uc774 \uc138\ud2b8\ucc98\ub7fc \ub9c8\uc74c\uc5d0 \ub4dc\ub294 \uac83\uc744 \ub0b4 \ubc29\uc5d0 \ub193\uc544 \ubcf4\uc790. \uc0ac\uc9c4 \uac8c\uc2dc\ud310\uacfc \ucc45\uc0c1\uc740 \uc0c1\uc810\uc5d0\uc11c \uc6a9\ub3c8\uc73c\ub85c \uc0b4 \uc218 \uc788\uc5b4."
    en: "Place something you like in your room, such as a toy kitchen or a first aid play set. You can buy a photo board or a desk with your allowance at the store."
  - key: dream.day.3.next
    ko: "\ub0b4 \ubc29\uc5d0 \ub0b4 \uafc8\uacfc \uc5b4\uc6b8\ub9ac\ub294 \uac00\uad6c\ub97c \ub193\uc544 \ubcf4\uc790."
    en: "Put furniture that suits your dream in your room."
  - key: dream.work.errand-helper
    ko: "\uc2dd\uc7ac\ub8cc \uc2ec\ubd80\ub984"
    en: "Run grocery errands"
  - key: dream.work.supply-helper
    ko: "\ube44\ud488 \uc815\ub9ac"
    en: "Sort clinic supplies"
  - key: dream.work.fitness-helper
    ko: "\uccb4\ub825 \ud6c8\ub828 \ub3d5\uae30"
    en: "Help with fitness training"
  - key: dream.route.errand-work
    ko: "\uc2dd\uc7ac\ub8cc \uc2ec\ubd80\ub984"
    en: "Run grocery errands"
  - key: dream.route.errand-work.description
    ko: "\uc2dd\ub2f9\uc758 \uc2dd\uc7ac\ub8cc \uc2ec\ubd80\ub984\uc744 \uc644\ub8cc\ud55c\ub2e4."
    en: "Complete grocery errands for the restaurant."
  - key: dream.route.supply-work
    ko: "\ube44\ud488 \uc815\ub9ac"
    en: "Sort clinic supplies"
  - key: dream.route.supply-work.description
    ko: "\ubcf4\uac74 \uc9c4\ub8cc\uc18c\uc758 \ube44\ud488 \uc815\ub9ac\ub97c \uc644\ub8cc\ud55c\ub2e4."
    en: "Sort supplies at the medical clinic."
  - key: dream.route.fitness-work
    ko: "\uccb4\ub825 \ud6c8\ub828 \ub3d5\uae30"
    en: "Help with fitness training"
  - key: dream.route.fitness-work.description
    ko: "\ud6c8\ub828\uc7a5\uc758 \uccb4\ub825 \ud6c8\ub828\uc744 \ub3d5\ub294\ub2e4."
    en: "Help with fitness training at the training ground."
  - key: dream.facility.restaurant.result
    ko: "\uc74c\uc2dd\uc73c\ub85c \uc774\uc6c3\uc744 \ub3cc\ubcf4\ub294 \uacf3\uc774\uc57c. \uc7ac\ub8cc \uc21c\uc11c\ub9cc \uc798 \uc678\uc6cc\ub3c4 \ud070 \ub3c4\uc6c0\uc774 \ub41c\ub2e8\ub2e4. \ud574 \ubcf4\uace0 \uc2f6\uc73c\uba74 \uc5b8\uc81c\ub4e0 \uc77c\uc744 \ub3c4\uc640\uc8fc\ub834."
    en: "We care for neighbors through food here. Just remembering the order of ingredients is a big help. Come help whenever you like."
  - key: dream.facility.medical-clinic.result
    ko: "\uc544\ud508 \uc0ac\ub78c\uacfc \ub3d9\ubb3c\uc744 \uc0b4\ud53c\ub294 \uacf3\uc774\uc57c. \uba3c\uc800 \uce68\ucc29\ud558\uac8c \uc0c1\ud0dc\ub97c \ubcf4\ub294 \uac8c \uc81c\uc77c \uc911\uc694\ud574. \ube44\ud488 \uc815\ub9ac\ubd80\ud130 \ub3c4\uc640\uc904\ub798?"
    en: "We look after people and animals who are hurt. Staying calm and checking first matters most. Could you start by sorting supplies?"
  - key: dream.facility.design-studio.result
    ko: "\uc0ac\ub78c\uc5d0\uac8c \ub9de\ub294 \uacf5\uac04\uc744 \ub9cc\ub4dc\ub294 \uacf3\uc774\uc57c. \ub124 \ubc29\uc744 \uc5b4\ub5bb\uac8c \uafb8\ubbf8\uace0 \uc2f6\uc740\uc9c0 \uc0dd\uac01\ud574 \ubcf8 \uc801 \uc788\ub2c8?"
    en: "We make spaces that suit people. Have you thought about how you'd like your room to look?"
  - key: dream.facility.training-ground.result
    ko: "\ubab8\uc744 \uc6c0\uc9c1\uc774\uba74\uc11c \uaddc\uce59\uacfc \ud611\ub3d9\uc744 \ubc30\uc6b0\ub294 \uacf3\uc774\uc57c. \ubb34\ub9ac\ud558\uc9c0 \ub9d0\uace0, \uc815\ub9ac\ubd80\ud130 \uac19\uc774 \ud574 \ubcf4\uc790."
    en: "We learn rules and teamwork by moving our bodies. Don't push too hard. Let's start by tidying up together."
  - key: dream.teacher.chef
    ko: "\uc694\ub9ac\uc0ac\uac00 \ub418\uace0 \uc2f6\uad6c\ub098. \ub9db\uc788\ub294 \uc74c\uc2dd\uc740 \uc0ac\ub78c\uc744 \ub4e0\ub4e0\ud558\uac8c \ud558\uc9c0. \uc2dd\ub2f9\uc5d0 \uac00 \ubcf4\uba74 \ubc30\uc6b8 \uac8c \ub9ce\uc744 \uac70\uc57c."
    en: "So you want to be a chef. Good food keeps people going. You'll learn a lot at the restaurant."
  - key: dream.teacher.emergency-care
    ko: "\uc544\ud508 \uc774\ub97c \ub3d5\uace0 \uc2f6\uad6c\ub098. \ucc38 \ub4ec\uc9c1\ud55c \uafc8\uc774\uc57c. \uc9c4\ub8cc\uc18c \uc5b4\ub978\ub4e4\uaed8 \ub9ce\uc774 \uc5ec\ucb64 \ubcf4\ub834."
    en: "So you want to help those who are hurt. That's a dependable dream. Ask the people at the clinic plenty of questions."
  - key: dream.teacher.interior
    ko: "\uacf5\uac04\uc744 \uafb8\ubbf8\uace0 \uc2f6\uad6c\ub098. \ub124 \ubc29\ubd80\ud130 \ub9c8\uc74c\uaecf \uafb8\uba70 \ubcf4\ub834. \uc2a4\ud29c\ub514\uc624\uc5d0\ub3c4 \ub4e4\ub7ec \ubcf4\uace0."
    en: "So you want to design spaces. Start with your own room, and stop by the studio too."
  - key: dream.teacher.soldier
    ko: "\ubaa8\ub450\ub97c \uc9c0\ud0a4\uace0 \uc2f6\uad6c\ub098. \ubab8\uacfc \ub9c8\uc74c\uc744 \ud568\uaed8 \ub2e8\ub828\ud574\uc57c \ud55c\ub2e8\ub2e4. \ud6c8\ub828\uc7a5 \uc815\ub9ac\ubd80\ud130 \ub3c4\uc640 \ubcf4\ub834."
    en: "So you want to protect everyone. You'll need to train body and mind together. Start by helping at the training ground."
  - key: dream.teacher.changed
    ko: "\uafc8\uc774 \ubc14\ub00c\uc5c8\uad6c\ub098. \uad1c\ucc2e\uc544, \uc9c0\uae08\uae4c\uc9c0 \ud574 \ubcf8 \uc77c\uc740 \uc5b4\ub514 \uac00\uc9c0 \uc54a\ub294\ub2e8\ub2e4."
    en: "Your dream has changed. That's fine. What you've tried stays with you."
  - key: "Ask Librarian"
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8\uaed8 \ubb3b\uae30"
    en: "Ask Librarian"
  - key: "Ask"
    ko: "\ubb3b\uae30"
    en: "Ask"
  - key: dream.objective.select
    ko: "\uc7a5\ub798\ud76c\ub9dd \uace0\ub974\uae30"
    en: "Choose a dream"
  - key: dream.shop.buy
    ko: "{0} \uc0ac\uae30\n\uc6a9\ub3c8 {1}"
    en: "Buy {0}\nAllowance {1}"
  - key: dream.shop.owned
    ko: "{0}\n\uad6c\uc785\ud568"
    en: "{0}\nOwned"
  - key: dream.shop.bought
    ko: "{0}\uc744(\ub97c) \uc0c0\uc5b4\uc694! \ub0b4 \ubc29\uc5d0 \ub193\uc544 \ubcf4\uc138\uc694."
    en: "You bought {0}! Try placing it in your room."
  - key: dream.shop.not-enough
    ko: "\uc6a9\ub3c8\uc774 \ubaa8\uc790\ub77c\uc694. \uc77c\uc744 \ub3c4\uc640 \uc6a9\ub3c8\uc744 \ub354 \ubaa8\uc544 \ubcf4\uc138\uc694."
    en: "Not enough allowance. Help out somewhere to earn more."
  - key: dream.shop.failed
    ko: "\uc9c0\uae08\uc740 \uc0b4 \uc218 \uc5c6\uc5b4\uc694."
    en: "You can't buy this right now."
  - key: dream.furniture.photo-board.name
    ko: "\uae30\ub85d \uc0ac\uc9c4 \uac8c\uc2dc\ud310"
    en: "Memory Photo Board"
  - key: dream.furniture.study-desk.name
    ko: "\ub098\uc758 \uc870\ub9bd \ucc45\uc0c1"
    en: "My Study Desk"
  - key: dream.wait.next-day
    ko: "\uc624\ub298 \ud560 \uc77c\uc744 \ub2e4 \ud588\uc5b4\uc694. \uc774\uc57c\uae30\ub294 \ub0b4\uc77c \uc774\uc5b4\uc838\uc694."
    en: "That's all for today. The story continues tomorrow."
  - key: "npc.first-guide.name"
    ko: "\uc5c4\ub9c8"
    en: "Mom"
  - key: "npc.first-guide.intro"
    ko: "\ub298 \uacc1\uc5d0\uc11c \uc9c0\ucf1c\ubd10 \uc8fc\ub294 \uc5c4\ub9c8\uc608\uc694. \uc624\ub298 \ud560 \uc77c\uc774 \ub9c9\ub9c9\ud558\uba74 \ub9d0\uc744 \uac78\uc5b4 \ubcf4\uc138\uc694."
    en: "Mom, always looking out for you. Talk to her when you're not sure what to do."
  - key: "npc.first-guide.hint.day-summary"
    ko: "\uc624\ub298 \ud558\ub8e8\uac00 \uc5b4\ub560\ub294\uc9c0 \uc774\uc57c\uae30\ud574 \ubd10\uc694."
    en: "Talk about how your day went."
  - key: "npc.first-guide.hint.place-recommend"
    ko: "\uc5b4\ub514\ubd80\ud130 \uac00\uba74 \uc88b\uc744\uc9c0 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask where to go first."
  - key: "npc.first-guide.notice.today-route"
    ko: "\uc624\ub298 \uc5b4\ub514\uc5d0 \uac08\uc9c0 \ud568\uaed8 \uc815\ud574 \ubd24\uc5b4\uc694."
    en: "You talked over where to go today."
  - key: "npc.first-guide.notice.tomorrow"
    ko: "\ub0b4\uc77c \ud560 \uc77c\uc744 \ubbf8\ub9ac \uc774\uc57c\uae30\ud588\uc5b4\uc694."
    en: "You talked about tomorrow."
  - key: "npc.librarian.name"
    ko: "\uc0ac\uc11c \uc120\uc0dd\ub2d8"
    en: "Librarian"
  - key: "npc.librarian.intro"
    ko: "\ub3c4\uc11c\uad00\uc744 \ub3cc\ubcf4\ub294 \ubd84\uc774\uc5d0\uc694. \uc77d\uc744 \ucc45\uc744 \uace8\ub77c \uc8fc\uc138\uc694."
    en: "Takes care of the library and helps you find books."
  - key: "npc.librarian.hint.book-recommend"
    ko: "\uc77d\uc744 \ub9cc\ud55c \ucc45\uc744 \ucd94\ucc9c\ubc1b\uc544\uc694."
    en: "Ask for a book recommendation."
  - key: "npc.librarian.hint.knowledge-route"
    ko: "\ud63c\uc790 \uacf5\ubd80\ud558\ub294 \ubc29\ubc95\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask how to study on your own."
  - key: "npc.librarian.notice.difficult-book"
    ko: "\uc5b4\ub824\uc6b4 \ucc45\ub3c4 \ucc9c\ucc9c\ud788 \uc77d\uc73c\uba74 \ub41c\ub300\uc694."
    en: "Even hard books are fine if you read slowly."
  - key: "npc.librarian.notice.village-rumor"
    ko: "\uc694\uc998 \ub3d9\ub124 \uc18c\uc2dd\uc744 \ub4e4\uc5c8\uc5b4\uc694."
    en: "You heard some neighborhood news."
  - key: "npc.shopkeeper.name"
    ko: "\uac00\uac8c \uc8fc\uc778"
    en: "Shopkeeper"
  - key: "npc.shopkeeper.intro"
    ko: "\ub3d9\ub124 \uac00\uac8c\ub97c \uafb8\ub824 \uac00\ub294 \ubd84\uc774\uc5d0\uc694."
    en: "Runs the corner store."
  - key: "npc.shopkeeper.hint.browse-goods"
    ko: "\uc624\ub298 \ub4e4\uc5b4\uc628 \ubb3c\uac74\uc744 \uad6c\uacbd\ud574\uc694."
    en: "Look at today's goods."
  - key: "npc.shopkeeper.hint.tomorrow-items"
    ko: "\ub0b4\uc77c \ub4e4\uc5b4\uc62c \ubb3c\uac74\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask what arrives tomorrow."
  - key: "npc.shopkeeper.notice.discount"
    ko: "\uac00\uac8c\uc5d0\uc11c \ud560\uc778 \uc18c\uc2dd\uc744 \ub4e4\uc5c8\uc5b4\uc694."
    en: "You heard about a sale at the store."
  - key: "npc.shopkeeper.notice.village-need"
    ko: "\ub3d9\ub124\uc5d0 \ud544\uc694\ud55c \ubb3c\uac74\uc744 \ub4e4\uc5c8\uc5b4\uc694."
    en: "You heard what the neighborhood needs."
  - key: "npc.teacher.name"
    ko: "\ub2f4\uc784 \uc120\uc0dd\ub2d8"
    en: "Teacher"
  - key: "npc.teacher.intro"
    ko: "\uc6b0\ub9ac \ubc18 \ub2f4\uc784 \uc120\uc0dd\ub2d8\uc774\uc5d0\uc694. \uc9c4\ub85c \uc774\uc57c\uae30\ub3c4 \ub4e4\uc5b4 \uc8fc\uc138\uc694."
    en: "Your homeroom teacher, who also listens to your plans."
  - key: "npc.teacher.hint.alt-growth"
    ko: "\ud559\uad50 \ubc16\uc5d0\uc11c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask about learning outside school."
  - key: "npc.teacher.hint.class-question"
    ko: "\uc218\uc5c5\uc5d0\uc11c \uad81\uae08\ud55c \uc810\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask about today's class."
  - key: "npc.teacher.notice.outside-school"
    ko: "\ud559\uad50 \ubc16\uc5d0\uc11c \uc120\uc0dd\ub2d8\uc744 \ub9cc\ub0ac\uc5b4\uc694."
    en: "You met your teacher outside school."
  - key: "npc.teacher.notice.study-basics"
    ko: "\uacf5\ubd80\uc758 \uae30\ucd08\ub97c \ub2e4\uc2dc \ub4e4\uc5c8\uc5b4\uc694."
    en: "You went over the basics of studying."
  - key: "npc.work-manager.name"
    ko: "\uacf5\ubc29 \uc544\uc800\uc528"
    en: "Workshop Manager"
  - key: "npc.work-manager.intro"
    ko: "\uacf5\ubc29 \uc77c\uc744 \ub9e1\uc544 \ubcf4\ub294 \ubd84\uc774\uc5d0\uc694. \uc77c\uac70\ub9ac\ub97c \ubb3c\uc5b4\ubcfc \uc218 \uc788\uc5b4\uc694."
    en: "Runs the workshop. You can ask about work."
  - key: "npc.work-manager.hint.errand-advice"
    ko: "\uc2ec\ubd80\ub984 \uc694\ub839\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask for errand tips."
  - key: "npc.work-manager.hint.part-time"
    ko: "\ud560 \uc218 \uc788\ub294 \uc77c\uc744 \ubb3c\uc5b4\ubd10\uc694."
    en: "Ask what work is available."
  - key: "npc.work-manager.notice.rest-advice"
    ko: "\ubb34\ub9ac\ud558\uc9c0 \ub9d0\uace0 \uc26c\ub77c\ub294 \ub9d0\uc744 \ub4e4\uc5c8\uc5b4\uc694."
    en: "You were told not to overdo it."
  - key: "npc.work-manager.notice.work-offer"
    ko: "\uc77c\uc744 \ub3c4\uc640 \ub2ec\ub77c\ub294 \ubd80\ud0c1\uc744 \ub4e4\uc5c8\uc5b4\uc694."
    en: "You were asked to help out."
  - key: "dialogue.first-guide.morning"
    ko: "\uc624\ub298\ub3c4 \uc88b\uc740 \ud558\ub8e8 \ubcf4\ub0b4\ub834."
    en: "Have a good day today."
  - key: "dialogue.first-guide.evening"
    ko: "\uc624\ub298 \ud558\ub8e8\ub294 \uc5b4\ub560\ub2c8? \ud479 \uc26c\ub834."
    en: "How was your day? Get some rest."
  - key: "dialogue.guide.day2"
    ko: "\uc624\ub298\uc740 \ub3d9\ub124\ub97c \ub458\ub7ec\ubcf4\ub834. \uc5b4\ub978\ub4e4\uc774 \ud558\ub294 \uc77c\uc744 \ubcfc \uc218 \uc788\uc744 \uac70\uc57c."
    en: "Look around town today. You can see the work grown-ups do."
  - key: "dialogue.shopkeeper.intro"
    ko: "\uc5b4\uc11c \uc624\ub834. \ud544\uc694\ud55c \uac8c \uc788\uc73c\uba74 \ub9d0\ud574 \uc8fc\ub834."
    en: "Welcome. Tell me if you need anything."
  - key: "dialogue.shopkeeper.square"
    ko: "\uad11\uc7a5\uc5d0 \ub098\uc624\ub2c8 \ubc14\ub78c\uc774 \uc88b\uad6c\ub098."
    en: "It's nice out here on the square."
  - key: "dialogue.shopkeeper.store"
    ko: "\ucc9c\ucc9c\ud788 \uad6c\uacbd\ud558\ub834."
    en: "Take your time looking around."
  - key: "dialogue.choice.accept.quest_career_chef"
    ko: "\uc694\ub9ac \uc77c\uc744 \uc54c\uc544\ubcfc\uac8c\uc694"
    en: "I'll learn about cooking"
  - key: "dialogue.choice.accept.quest_career_emergency_care"
    ko: "\uc751\uae09 \ucc98\uce58\ub97c \uc54c\uc544\ubcfc\uac8c\uc694"
    en: "I'll learn about first aid"
  - key: "dialogue.choice.accept.quest_career_interior"
    ko: "\uacf5\uac04 \uafb8\ubbf8\uae30\ub97c \uc54c\uc544\ubcfc\uac8c\uc694"
    en: "I'll learn about room design"
  - key: "dialogue.choice.accept.quest_career_soldier"
    ko: "\ud6c8\ub828\uc744 \uc54c\uc544\ubcfc\uac8c\uc694"
    en: "I'll learn about training"
  - key: "dialogue.choice.claim.quest_career_chef"
    ko: "\ub2e4 \ud574 \ubd24\uc5b4\uc694"
    en: "I tried it"
  - key: "dialogue.choice.claim.quest_career_emergency_care"
    ko: "\ub2e4 \ud574 \ubd24\uc5b4\uc694"
    en: "I tried it"
  - key: "dialogue.choice.claim.quest_career_interior"
    ko: "\ub2e4 \ud574 \ubd24\uc5b4\uc694"
    en: "I tried it"
  - key: "dialogue.choice.claim.quest_career_soldier"
    ko: "\ub2e4 \ud574 \ubd24\uc5b4\uc694"
    en: "I tried it"
  - key: "objective.daily.career.interior-practice.title"
    ko: "\uacf5\uac04 \uafb8\ubbf8\uae30 \uc2e4\uc2b5"
    en: "Room design practice"
  - key: "objective.daily.career.interior-practice.detail"
    ko: "\ub514\uc790\uc778 \uc2a4\ud29c\ub514\uc624\uc5d0\uc11c \uacf5\uac04 \uafb8\ubbf8\uae30\ub97c \uc5f0\uc2b5\ud574\uc694."
    en: "Practice room design at the studio."
  - key: "objective.daily.career.interior-practice.next"
    ko: "\ub514\uc790\uc778 \uc2a4\ud29c\ub514\uc624\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the design studio."
  - key: "objective.daily.library.title"
    ko: "\ub3c4\uc11c\uad00\uc5d0\uc11c \uc790\uc728 \ud559\uc2b5"
    en: "Study at the library"
  - key: "objective.daily.library.detail"
    ko: "\ub3c4\uc11c\uad00\uc5d0\uc11c \ud63c\uc790 \uacf5\ubd80\ud574\uc694."
    en: "Study on your own at the library."
  - key: "objective.daily.library.next"
    ko: "\ub3c4\uc11c\uad00\uc73c\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the library."
  - key: "objective.daily.library.archive.title"
    ko: "\ub3c4\uc11c\uad00 \uae30\ub85d\uc2e4 \uc870\uc0ac"
    en: "Library records research"
  - key: "objective.daily.library.archive.detail"
    ko: "\ub3c4\uc11c\uad00 \uae30\ub85d\uc2e4\uc5d0\uc11c \uc790\ub8cc\ub97c \ucc3e\uc544\ubd10\uc694."
    en: "Look through the library records."
  - key: "objective.daily.library.archive.next"
    ko: "\ub3c4\uc11c\uad00 \uae30\ub85d\uc2e4\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the library records room."
  - key: "objective.daily.town-square.title"
    ko: "\uad11\uc7a5\uc5d0\uc11c \uc774\uc6c3 \ub3d5\uae30"
    en: "Help neighbors on the square"
  - key: "objective.daily.town-square.detail"
    ko: "\uad11\uc7a5\uc5d0\uc11c \ub3c4\uc6c0\uc774 \ud544\uc694\ud55c \uc774\uc6c3\uc744 \ub3c4\uc640\uc694."
    en: "Help neighbors who need it on the square."
  - key: "objective.daily.town-square.next"
    ko: "\ub9c8\uc744 \uad11\uc7a5\uc73c\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the town square."
  - key: "objective.daily.workshop.title"
    ko: "\uacf5\ubc29 \uc544\ub974\ubc14\uc774\ud2b8"
    en: "Workshop job"
  - key: "objective.daily.workshop.detail"
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc77c\uc744 \ub3c4\uc640\uc694."
    en: "Help out at the workshop."
  - key: "objective.daily.workshop.next"
    ko: "\uacf5\ubc29\uc73c\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the workshop."
  - key: "objective.daily.workshop.repair-ledger.title"
    ko: "\uacf5\ubc29 \uc218\ub9ac \uc7a5\ubd80 \uc0b4\ud3b4\ubcf4\uae30"
    en: "Check the repair ledger"
  - key: "objective.daily.workshop.repair-ledger.detail"
    ko: "\uacf5\ubc29\uc5d0\uc11c \uc218\ub9ac \uae30\ub85d\uc744 \uc0b4\ud3b4\ubd10\uc694."
    en: "Look at repair records at the workshop."
  - key: "objective.daily.workshop.repair-ledger.next"
    ko: "\uacf5\ubc29\uc73c\ub85c \uac00 \ubcf4\uc138\uc694."
    en: "Go to the workshop."
  - key: "objective.recipe.field-notes.next"
    ko: "\uc7ac\ub8cc\ub97c \ubaa8\uc544 \uad00\ucc30 \ub178\ud2b8\ub97c \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694."
    en: "Gather materials and make field notes."
  - key: "milestone.first-guide-trust"
    ko: "\uc5c4\ub9c8\uc758 \ubbff\uc74c"
