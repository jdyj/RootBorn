{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/detect-feedback.js"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-hint.sh"
          }
        ]
      }
    ]
  }
}
