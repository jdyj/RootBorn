<Project Sdk="Microsoft.NET.Sdk">
  <!-- 실행 프로그램. 창, 입력, 글자, 그리기. MonoGame 참조는 여기(와 이 프로젝트의 테스트)에만 둔다.
       MonoGame 버전은 정확히 고정한다: 테스트의 프레임 진행과 한글 조합 입력이 이 버전의 내부 동작에 기댄다
       (.claude/rules/engine-migration.md). 콘텐츠 변환 파이프라인(MGCB)은 쓰지 않는다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Rootborn.Host</RootNamespace>
    <AssemblyName>Rootborn.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rootborn.Ui/Rootborn.Ui.csproj" />
    <ProjectReference Include="../Rootborn.Core/Rootborn.Core.csproj" />
    <ProjectReference Include="../Rootborn.World/Rootborn.World.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="[3.8.6.1]" />
    <PackageReference Include="StbTrueTypeSharp" Version="[1.26.12]" />
  </ItemGroup>
</Project>
