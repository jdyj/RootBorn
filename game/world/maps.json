      },
      // Unity Town.unity TownLevelTransition_Level0ToLevel1: 가운데 (37.5, -62.6) 44x1.4유닛 → 마을 아래 가장자리
      "areas": [ { "name": "beach", "rect": [ 496, 2012.8, 1408, 44.8 ], "to": { "map": "Beach", "spawn": "beach-top-entry" }, "openSeconds": 0.25 } ]
