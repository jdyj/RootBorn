      },
      // Beach.unity BeachLevelTransition_BeachToTown: 가운데 (37.5, -63.4) 44x1.4유닛 → 해변 위 가장자리
      "areas": [ { "name": "town", "rect": [ -16, 22.4, 1408, 44.8 ], "to": { "map": "Town", "spawn": "town-bottom-entry" }, "openSeconds": 0.25 } ]
    },
    {
      // 학교: interiors.ldtk School_1. School.unity는 줄 밀림이 없다(LDtk r행 = 씬 칸 -(r+1)) → 픽셀 (x*32, -y*32).
      // 마을의 학교 입구(TownSchoolPortal)와 학교 출구의 목적지(town-school-entry)는 LDtk 마을 그림 밖 북쪽 구역에 있었다.
      // 새 맵 전까지 임시 연결로 잇는다(마을 문 'north', 이 맵의 areas, 마을 도착 지점 town-school-entry — game/world/README.md "임시 연결 목록").
      "id": "School",
      "ldtk": "Assets/LDtk/Interiors/interiors.ldtk",
      "level": "School_1",
      "viewCells": 11,
      // School.unity의 Structure_x_y 충돌 상자 = Border·Wall 층 타일에서 (3,11)(3,12) 두 칸을 뺀 것(실내 자동 판정과 다르다).
      "collision": { "rule": "collider-layers", "layers": [ "Border", "Wall" ], "openCells": [ [ 3, 11 ], [ 3, 12 ] ] },
      "doorField": "Where",
      "spawnField": "Position",
