<Project Sdk="Microsoft.NET.Sdk">
  <!-- 데디케이티드 서버(화면 없는 콘솔): 인자 읽기와 루프 돌리기만 한다. 방·접속·틱은 Rootborn.Net/Room에 있다.
       Game(게임 버전), Data(정의 읽기, 세이브 파일), Net만 참조한다. 그림·글꼴·창 참조 금지. Windows와 Linux에서 돈다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rootborn.Game/Rootborn.Game.csproj" />
    <ProjectReference Include="../Rootborn.Data/Rootborn.Data.csproj" />
    <ProjectReference Include="../Rootborn.Net/Rootborn.Net.csproj" />
  </ItemGroup>
</Project>
