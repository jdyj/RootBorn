<Project Sdk="Microsoft.NET.Sdk">
  <!-- 멀티플레이 바탕: 전송 인터페이스(같은 프로세스·UDP), 메시지 종류 등록 표와 이진 형식, 접속 세션.
       규칙 판단(정원, 도착 위치, 방의 시계, 사이 메우기)은 Core에 있다. 게임 엔진 참조 금지. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rootborn.Core/Rootborn.Core.csproj" />
    <!-- 손님 세이브 폴더(GuestSaveFolder: 파일 저장소·메모리 슬롯). 데디케이티드 서버와 내 PC에서 연 방이 같이 쓴다. 정의 읽기와 게임 규칙은 쓰지 않는다. -->
    <ProjectReference Include="../Rootborn.Data/Rootborn.Data.csproj" />
    <!-- LiteNetLib(MIT): 순수 C# UDP, 신뢰 순서 채널. 네이티브 파일이 없다. 1.x API로 쓴다(2.x는 2026년에 나온 큰 변경이라 검증 전).
         버전을 올릴 때는 Transport/UdpTransport.cs 한 곳만 보고 UDP 테스트를 돌린다. -->
    <PackageReference Include="LiteNetLib" Version="[1.3.5]" />
  </ItemGroup>
</Project>
