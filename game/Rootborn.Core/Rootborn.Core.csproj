<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packages/com.rootborn.core/Runtime 소스를 그대로 묶는다. 이 폴더에 코드 파일을 두지 않는다.
       LangVersion 9는 Unity가 컴파일하는 버전과 같다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Rootborn.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.rootborn.core/Runtime/**/*.cs" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
