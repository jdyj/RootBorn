<Project Sdk="Microsoft.NET.Sdk">
  <!-- 스스로 플레이하는 자동 플레이어(대본 없음). Play/는 판단·관찰·불변식·기록(창이 있든 없든 같은 코드),
       Headless/는 창 없는 몸(화면 쌓기 + 월드 걷기를 프레임 단위로 돌린다). 실제 창 층은 Rootborn.Host.Tests/Simulation이 이 프로젝트를 참조한다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rootborn.Screens/Rootborn.Screens.csproj" />
    <ProjectReference Include="../../Rootborn.World/Rootborn.World.csproj" />
    <ProjectReference Include="../../Rootborn.Data/Rootborn.Data.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 알려진 빠진 현지화 키 목록은 화면 테스트와 같은 것을 쓴다. -->
    <Compile Include="../Rootborn.Screens.Tests/KnownMissingKeys.cs" Link="KnownMissingKeys.cs" />
  </ItemGroup>
</Project>
