<Project Sdk="Microsoft.NET.Sdk">
  <!-- 수치 균형 시뮬레이터: 창 없이 GameSession으로 여러 날 돈 흐름을 돌린다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 모든 경우 훑기는 판마다 세이브를 JSON으로 자주 쓰므로 할당이 많다. 워크스테이션 GC는 병렬 판을 자주 멈춰 코어를 절반도 못 쓴다. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rootborn.Game/Rootborn.Game.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 실제 data/를 읽는 도우미와 하루 균형 가정은 Game 테스트와 같은 사본을 쓴다. -->
    <Compile Include="../Rootborn.Game.Tests/TestWorld.cs" Link="Shared/TestWorld.cs" />
    <Compile Include="../Rootborn.Game.Tests/DayAssumptions.cs" Link="Shared/DayAssumptions.cs" />
    <!-- 속도 기록·분석·보고(먼 층)는 Simulation 테스트(가까운 층)와 같은 사본을 쓴다. 화면·창 없는 몸에 닿는 것(기록기·분류)은 들이지 않는다. -->
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceStep.cs" Link="Shared/Pace/PaceStep.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceAssumptions.cs" Link="Shared/Pace/PaceAssumptions.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceAnalysis.cs" Link="Shared/Pace/PaceAnalysis.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceNovelty.cs" Link="Shared/Pace/PaceNovelty.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceReport.cs" Link="Shared/Pace/PaceReport.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceCompare.cs" Link="Shared/Pace/PaceCompare.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceDiff.cs" Link="Shared/Pace/PaceDiff.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceBands.cs" Link="Shared/Pace/PaceBands.cs" />
    <Compile Include="../Rootborn.Simulation.Tests/Pace/PaceMeasured.cs" Link="Shared/Pace/PaceMeasured.cs" />
  </ItemGroup>
</Project>
