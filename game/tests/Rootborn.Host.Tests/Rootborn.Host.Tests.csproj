<Project Sdk="Microsoft.NET.Sdk">
  <!-- 실제 게임 루프와 창으로 도는 테스트. 조작은 PlayerDriver만 쓴다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 진입점은 TwoGames/PeerProgram(두 게임 테스트가 이 어셈블리를 두 번째 게임으로 띄운다). 테스트 SDK가 만드는 빈 진입점 대신. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rootborn.Host/Rootborn.Host.csproj" />
    <!-- 스스로 플레이하는 시뮬레이션(Simulation/)이 창 없는 층과 같은 판단·관찰·불변식 코드를 쓴다. -->
    <ProjectReference Include="../Rootborn.Simulation.Tests/Rootborn.Simulation.Tests.csproj" />
    <!-- 손님 저장을 받는 방(데디케이티드 서버와 같은 손님 세이브 폴더)을 테스트 안에 띄운다. -->
    <ProjectReference Include="../../Rootborn.Server/Rootborn.Server.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="[3.8.6.1]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 알려진 빠진 현지화 키 목록은 화면 테스트와 같은 것을 쓴다. -->
    <Compile Include="../Rootborn.Screens.Tests/KnownMissingKeys.cs" Link="KnownMissingKeys.cs" />
  </ItemGroup>
</Project>
