<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core 규칙(game/Rootborn.Core) 단위 테스트. 엔진 없이 몇 초에 돈다: dotnet test game/tests/Rootborn.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rootborn.Core/Rootborn.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 픽셀 키트가 낸 방 고르기 시험 표. Core는 파일을 읽지 않고 테스트(Building/RoomVectors.cs)가 읽는다. -->
    <None Include="../../../Tools/pixel-kit/tests/fixtures/room-vectors.json" Link="Fixtures/room-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
